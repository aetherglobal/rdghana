DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require

# DATABASE_CA — production only: inline PEM of the RDS region CA bundle (for verified
# TLS to RDS). Not needed for local dev / Neon (its cert chains to a public CA).
# Fetch with: curl https://truststore.pki.rds.amazonaws.com/<region>/<region>-bundle.pem
# DATABASE_CA=
# DATABASE_SSL_NO_VERIFY=true   # alternative to DATABASE_CA: encrypt without cert verification (weaker)
# DATABASE_POOL_MAX=5           # optional per-instance connection pool cap (default 5)

PAYLOAD_SECRET=change-me

S3_BUCKET=random-bucket
S3_ACCESS_KEY_ID=random-access-key
S3_SECRET_ACCESS_KEY=random-secret
S3_REGION=random-region
S3_ENDPOINT=
