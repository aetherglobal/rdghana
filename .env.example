# DATABASE_URI differs per environment:
#   local dev  -> dedicated Neon branch
#   staging    -> Neon (staging branch)
#   production -> AWS RDS via RDS Proxy (main branch)
DATABASE_URI=postgresql://user:password@host/dbname?sslmode=require
PAYLOAD_SECRET=change-me

# Postgres SSL / pool (optional).
# RDS: supply its CA bundle (PEM) so SSL verification passes,
# or set DATABASE_SSL_NO_VERIFY=true to skip verification. Neon needs neither.
# DATABASE_CA=
# DATABASE_SSL_NO_VERIFY=false
# DATABASE_POOL_MAX=5

# Media storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO).
# Auto-enables when S3_BUCKET + S3_ACCESS_KEY_ID + S3_SECRET_ACCESS_KEY are all set.
# S3_ENDPOINT is required for R2/MinIO; omit for AWS S3.
S3_BUCKET=random-bucket
S3_ACCESS_KEY_ID=random-access-key
S3_SECRET_ACCESS_KEY=random-secret
S3_REGION=random-region
S3_ENDPOINT=
